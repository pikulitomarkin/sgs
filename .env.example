# ============================================================
# SGS — Modelo de ambiente (servidor Dell / LAN do cliente)
# Uso: cp .env.example .env   (ou use o .env já preenchido no pacote)
# IP padrão do cliente: 192.168.18.176
# ============================================================

# Servidor / portas
SERVER_IP=192.168.18.176
APP_PORT=80
PAINEL_PORT=8080
TRIAGEM_PORT=8081
TOTEM_PORT=8082
PAINEL_TV_PORT=8083
MERCURE_PORT=3000
TZ=America/Sao_Paulo
APP_LANGUAGE=pt_BR
APP_ENV=prod

# Banco
DB_NAME=novosga2
DB_USER=novosga
DB_PASSWORD=SgsDb_App_00351!
DB_ROOT_PASSWORD=SgsDb_Root_00351!

# Admin NovoSGA
NOVOSGA_ADMIN_USERNAME=admin
NOVOSGA_ADMIN_PASSWORD=00351master
NOVOSGA_ADMIN_FIRSTNAME=Administrador
NOVOSGA_ADMIN_LASTNAME=SGS

# Unidade / filas
NOVOSGA_UNITY_NAME=Cartorio SGS
NOVOSGA_UNITY_CODE=SGS01
NOVOSGA_NOPRIORITY_NAME=Normal
NOVOSGA_NOPRIORITY_DESCRIPTION=Atendimento normal
NOVOSGA_PRIORITY_NAME=Prioridade
NOVOSGA_PRIORITY_DESCRIPTION=Atendimento prioritario
NOVOSGA_PLACE_NAME=Guiche

# Mercure — IP acessível pelos navegadores (TV, totem, guichês)
MERCURE_PUBLIC_URL=http://192.168.18.176:3000/.well-known/mercure
MERCURE_JWT_SECRET=SgsMercureJwtSecret_00351_ChangeInProd!

# Impressora Bematech MP-4200 (Ethernet)
PRINTER_IP=
PRINTER_PORT=9100
PRINTER_NAME=Bematech-MP4200

# OAuth (criar no admin NovoSGA → API / Clientes)
TOTEM_CLIENT_ID=totem
TOTEM_CLIENT_SECRET=totemsecret
PAINEL_CLIENT_ID=painel
PAINEL_CLIENT_SECRET=painelsecret
